# Non-secret Compose configuration. Secret file contents belong under .secrets/.
SKILLWIRE_PORT=3000
SKILLWIRE_ALLOWED_HOSTS=localhost,127.0.0.1
SKILLWIRE_CATALOG_RELEASE=launch-catalog-v1
SKILLWIRE_ACCOUNT_REQUESTS_PER_MINUTE=120
SKILLWIRE_API_KEY_REQUESTS_PER_MINUTE=120
SKILLWIRE_RATE_LIMIT_BURST=30
SKILLWIRE_AUTHENTICATION_REQUESTS_PER_MINUTE=600
SKILLWIRE_AUTHENTICATION_RATE_LIMIT_BURST=60
SKILLWIRE_AUDIT_CLEANUP_INTERVAL_SECONDS=3600
SKILLWIRE_SHUTDOWN_GRACE_MS=10000
LOG_LEVEL=info

# Paths only; these files must be generated locally and are gitignored.
SKILLWIRE_DATABASE_URL_SECRET_FILE=./.secrets/database-url
SKILLWIRE_POSTGRES_PASSWORD_SECRET_FILE=./.secrets/postgres-password
SKILLWIRE_API_KEY_PEPPER_SECRET_FILE=./.secrets/api-key-pepper
SKILLWIRE_BOOTSTRAP_API_KEY_SECRET_FILE=./.secrets/api-key
