{
  "name": "skillwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP skill discovery service",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "auth:admin": "tsx src/authentication/admin-cli.ts",
    "advisory:verify": "tsx src/catalog/advisory-verify-cli.ts",
    "catalog:publish": "tsx src/catalog/publish-cli.ts",
    "catalog:verify": "tsx src/catalog/verify-cli.ts",
    "db:migrate": "tsx src/persistence/postgres/migration-runner.ts",
    "source:admin": "tsx src/ingestion/admin-cli.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:github-live": "tsx scripts/smoke-github-live.ts",
    "benchmark:informational": "tsx benchmarks/informational-benchmark.ts",
    "benchmark:validate": "tsx benchmarks/informational-benchmark.ts --validate-only",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "format": "prettier --write src tests catalog evaluation distribution benchmarks scripts .github README.md docs package.json tsconfig.json vitest.config.ts eslint.config.mjs .prettierrc.json compose.yaml compose.test.yaml compose.benchmark.yaml",
    "format:check": "prettier --check src tests catalog evaluation distribution benchmarks scripts .github README.md docs package.json tsconfig.json vitest.config.ts eslint.config.mjs .prettierrc.json compose.yaml compose.test.yaml compose.benchmark.yaml",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "vitest run --project e2e",
    "test:evaluation": "vitest run --project evaluation --passWithNoTests",
    "test:security": "vitest run --project security --passWithNoTests",
    "test:activation": "vitest run tests/unit/evaluation/activation-corpus.test.ts tests/unit/evaluation/manual-evidence.test.ts tests/unit/transport/activation-policy.test.ts tests/unit/domain/ranking.test.ts tests/contract/cli/activation-evidence.test.ts tests/contract/mcp/activation-metadata.test.ts tests/contract/mcp/search-skills.test.ts tests/contract/mcp/load-skill.test.ts tests/integration/service/activation-memory-attribution.test.ts tests/e2e/autonomous-activation-transport.test.ts tests/evaluation/autonomous-activation.test.ts tests/security/transport/autonomous-activation-boundaries.test.ts",
    "test:activation-adapter": "vitest run tests/unit/evaluation/codex-adapter-package.test.ts tests/unit/evaluation/codex-marketplace.test.ts tests/unit/evaluation/activation-corpus.test.ts tests/unit/evaluation/manual-evidence.test.ts tests/contract/cli/codex-activation-plugin.test.ts tests/contract/cli/activation-evidence.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "hono": "4.13.1",
    "mdast-util-from-markdown": "2.0.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@openai/codex": "0.147.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
