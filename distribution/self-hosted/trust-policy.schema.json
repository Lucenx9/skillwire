{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillwire.dev/schemas/skillwire.trust-policy.v1.json",
  "title": "SkillWire self-hosted trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "minimumReleaseSequence",
    "validFrom",
    "validUntil",
    "trustedRoot",
    "cosign",
    "signers",
    "deniedSigners",
    "deniedManifestDigests",
    "overlap"
  ],
  "properties": {
    "schemaVersion": { "const": "skillwire.trust-policy/v1" },
    "sequence": { "type": "integer", "minimum": 1 },
    "minimumReleaseSequence": { "type": "integer", "minimum": 1 },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "trustedRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mediaType"],
      "properties": {
        "path": { "const": "trusted-root.v1.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": {
          "const": "application/vnd.dev.sigstore.trustedroot+json;version=0.1"
        }
      }
    },
    "cosign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "binaries"],
      "properties": {
        "version": { "const": "3.1.3" },
        "binaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amd64", "arm64"],
          "properties": {
            "amd64": { "$ref": "#/$defs/sha256" },
            "arm64": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "signers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signerId",
          "issuer",
          "repository",
          "workflow",
          "refPattern"
        ],
        "properties": {
          "signerId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "issuer": { "const": "https://token.actions.githubusercontent.com" },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "workflow": {
            "type": "string",
            "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
          },
          "refPattern": {
            "type": "string",
            "pattern": "^refs/tags/[A-Za-z0-9.*_-]+$"
          }
        }
      }
    },
    "deniedSigners": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 256 }
    },
    "deniedManifestDigests": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "overlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousSequence", "requiredSignerCount"],
      "properties": {
        "previousSequence": { "type": ["integer", "null"], "minimum": 1 },
        "requiredSignerCount": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
