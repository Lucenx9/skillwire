{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillwire.dev/contracts/search_skills.input.schema.json",
  "title": "search_skills input",
  "type": "object",
  "additionalProperties": false,
  "required": ["task"],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "repositoryHash": {
      "$ref": "./common.schema.json#/$defs/RepositoryHash"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5
    }
  }
}
