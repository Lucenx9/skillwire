{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillwire.dev/contracts/load_skill.output.schema.json",
  "title": "load_skill successful structured output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "revision",
    "revisionSha256",
    "publishedProvenance",
    "currentAdvisoryStatus",
    "instructions",
    "resourceManifest",
    "memoryRecorded"
  ],
  "properties": {
    "skillId": {
      "$ref": "./common.schema.json#/$defs/SkillId"
    },
    "revision": {
      "$ref": "./common.schema.json#/$defs/Revision"
    },
    "revisionSha256": {
      "$ref": "./common.schema.json#/$defs/Sha256"
    },
    "publishedProvenance": {
      "$ref": "./common.schema.json#/$defs/PublishedProvenance"
    },
    "currentAdvisoryStatus": {
      "$ref": "./common.schema.json#/$defs/CurrentAdvisoryStatus"
    },
    "instructions": {
      "type": "string",
      "maxLength": 262144
    },
    "resourceManifest": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "./common.schema.json#/$defs/ResourceManifestEntry"
      }
    },
    "memoryRecorded": {
      "type": "boolean"
    }
  }
}
