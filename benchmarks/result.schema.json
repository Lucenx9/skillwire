{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillwire.dev/benchmarks/result.schema.json",
  "title": "SkillWire informational benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "rawRowsSha256",
    "rawRows",
    "aggregates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workloadId",
        "catalogRelease",
        "inventorySha256",
        "revisionBundleSha256s",
        "advisoryChainHead",
        "searchCorpus",
        "searchCorpusSha256",
        "journeyMatrix",
        "journeyMatrixSha256",
        "operationMixSha256",
        "databaseFixture",
        "operatingSystem",
        "kernel",
        "architecture",
        "cpuModel",
        "cpuAllocation",
        "memoryLimitBytes",
        "dockerVersion",
        "composeVersion",
        "imageDigests",
        "nodeVersion",
        "dependencyVersions",
        "skillwireVersion",
        "applicationCommit",
        "benchmarkRunnerSha256",
        "catalogCacheState",
        "concurrency",
        "warmupCount",
        "sampleCount",
        "fixtureResetCount",
        "clock",
        "availabilityContinuous",
        "startedAt",
        "endedAt"
      ],
      "properties": {
        "workloadId": { "const": "skillwire-operation-mix-v1" },
        "catalogRelease": { "type": "string" },
        "inventorySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "revisionBundleSha256s": {
          "type": "object",
          "minProperties": 10,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "advisoryChainHead": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "searchCorpus": { "const": "search-ranking-v1" },
        "searchCorpusSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "journeyMatrix": { "const": "three-call-journeys-v1" },
        "journeyMatrixSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operationMixSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "databaseFixture": { "const": "benchmark-fixture-v1" },
        "operatingSystem": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "cpuModel": { "type": "string", "minLength": 1 },
        "cpuAllocation": { "type": "integer", "minimum": 1 },
        "memoryLimitBytes": { "type": "string", "pattern": "^[0-9]+$" },
        "dockerVersion": { "type": "string", "minLength": 1 },
        "composeVersion": { "type": "string", "minLength": 1 },
        "imageDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skillwire", "postgres", "benchmarkClient"],
          "properties": {
            "skillwire": {
              "type": "string",
              "pattern": "^(?:[^\\s@]+@)?sha256:[0-9a-f]{64}$"
            },
            "postgres": {
              "type": "string",
              "pattern": "^(?:[^\\s@]+@)?sha256:[0-9a-f]{64}$"
            },
            "benchmarkClient": {
              "type": "string",
              "pattern": "^(?:[^\\s@]+@)?sha256:[0-9a-f]{64}$"
            }
          }
        },
        "nodeVersion": { "type": "string", "minLength": 1 },
        "dependencyVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pnpm",
            "postgres",
            "mcpClient",
            "mcpServer",
            "hono",
            "zod"
          ],
          "properties": {
            "pnpm": { "type": "string", "minLength": 1 },
            "postgres": { "type": "string", "minLength": 1 },
            "mcpClient": { "type": "string", "minLength": 1 },
            "mcpServer": { "type": "string", "minLength": 1 },
            "hono": { "type": "string", "minLength": 1 },
            "zod": { "type": "string", "minLength": 1 }
          }
        },
        "skillwireVersion": { "type": "string", "minLength": 1 },
        "applicationCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "benchmarkRunnerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalogCacheState": { "enum": ["catalog-cold", "catalog-warm"] },
        "concurrency": { "type": "integer", "minimum": 1 },
        "warmupCount": { "type": "integer", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "fixtureResetCount": { "const": 2 },
        "clock": { "const": "process.hrtime.bigint" },
        "availabilityContinuous": { "type": "boolean" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" }
      }
    },
    "rawRowsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rawRows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "clientId",
          "operation",
          "catalogCacheState",
          "startedOffsetNs",
          "durationNs",
          "resultCode"
        ],
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "clientId": { "type": "integer", "minimum": 0 },
          "operation": {
            "enum": [
              "search_skills",
              "load_skill",
              "read_skill_resource",
              "list_repo_memory",
              "record_skill_outcome",
              "forget_repo_memory"
            ]
          },
          "catalogCacheState": { "enum": ["catalog-cold", "catalog-warm"] },
          "startedOffsetNs": { "type": "string", "pattern": "^[0-9]+$" },
          "durationNs": { "type": "string", "pattern": "^[0-9]+$" },
          "resultCode": { "enum": ["ok", "tool-error", "exception"] }
        }
      }
    },
    "aggregates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "attempted",
          "succeeded",
          "failed",
          "p50DurationNs",
          "p95DurationNs",
          "p99DurationNs"
        ],
        "properties": {
          "operation": { "type": "string" },
          "attempted": { "type": "integer", "minimum": 0 },
          "succeeded": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "p50DurationNs": { "type": "string", "pattern": "^[0-9]+$" },
          "p95DurationNs": { "type": "string", "pattern": "^[0-9]+$" },
          "p99DurationNs": { "type": "string", "pattern": "^[0-9]+$" }
        }
      }
    }
  }
}
